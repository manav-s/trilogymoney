generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  // clerkId removed with Clerk
  email             String?        @unique
  phone             String?        @unique // E.164 format
  phoneVerified     Boolean        @default(false)
  timezone          String         @default("America/Los_Angeles")
  preferredTime     String         @default("09:00") // HH:mm format
  name              String?
  
  // Onboarding state
  onboardingStatus  String         @default("pre_auth") // pre_auth, clerk_complete, plaid_complete, complete
  consent           Boolean        @default(false)
  
  // Service status
  isActive          Boolean        @default(true)
  messagingStatus   String         @default("inactive") // inactive, active, stopped
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  plaidAccount      PlaidAccount?
  messages          Message[]
  
  @@index([phone])
}

model PlaidAccount {
  id          String    @id @default(cuid())
  userId      String    @unique
  accessToken String    @db.Text // Encrypted with ENCRYPTION_KEY
  itemId      String
  accountId   String    // Primary checking account
  bankName    String
  accountName String
  isActive    Boolean   @default(true)
  lastSync    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        String      @id @default(cuid())
  userId    String
  direction String      // 'outbound' or 'inbound'
  content   String      @db.Text // Encrypted with ENCRYPTION_KEY
  
  // Metadata (not encrypted)
  status    String      // 'sent', 'delivered', 'failed', 'received'
  provider  String?     @default("blooio")
  providerId String?    // External message ID from SMS provider
  error     String?     @db.Text
  
  sentAt    DateTime    @default(now())
  expiresAt DateTime    // Auto-calculated: sentAt + 60 days
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, sentAt])
  @@index([expiresAt]) // For cleanup jobs
}

model MagicLink {
  id        String   @id // Short nanoid (8-10 chars)
  phone     String   // E.164 format
  used      Boolean  @default(false)
  usedAt    DateTime?
  expiresAt DateTime // 10 minutes from creation
  createdAt DateTime @default(now())
  
  @@index([expiresAt]) // For cleanup jobs
  @@index([used, expiresAt])
}
