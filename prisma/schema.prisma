generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String      @id @default(cuid())
  email                     String?     @unique
  phone                     String?     @unique
  phoneVerified             Boolean     @default(false)
  timezone                  String      @default("America/Los_Angeles")
  preferredTime             String      @default("09:00")
  name                      String?
  onboardingStatus          String      @default("pre_auth")
  consent                   Boolean     @default(false)
  isActive                  Boolean     @default(true)
  messagingStatus           String      @default("inactive")
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  analysisSummary           Json?
  billingStatus             String?
  quizAnswers               Json?
  stripeCustomerId          String?
  stripePriceId             String?
  stripeSubscriptionId      String?
  lastWeeklyDigestAt        DateTime?
  lastTransactionsQuery     Json?
  postCheckoutBalanceSentAt DateTime?
  lastBalanceUpdateAt       DateTime?
  welcomeSentAt             DateTime?
  lowBalanceThreshold       Float?      @default(100)
  lastLowBalanceAlertAt     DateTime?
  pendingJobType            String?
  pendingJobAskedAt         DateTime?
  messages                  Message[]
  items                     PlaidItem[]

  @@index([phone])
}

model PlaidItem {
  id              String         @id @default(cuid())
  userId          String
  itemId          String         @unique
  accessToken     String
  institutionName String?
  lastSync        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accounts        PlaidAccount[]
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlaidAccount {
  id               String    @id @default(cuid())
  itemId           String
  accountId        String    @unique
  isActive         Boolean   @default(true)
  lastSync         DateTime?
  availableBalance Float?
  currency         String?
  currentBalance   Float?
  mask             String?
  name             String
  officialName     String?
  subtype          String?
  type             String
  item             PlaidItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model Message {
  id         String   @id @default(cuid())
  userId     String
  direction  String
  content    String
  status     String
  provider   String?  @default("blooio")
  providerId String?
  error      String?
  sentAt     DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([expiresAt])
}

model MagicLink {
  id        String   @id
  phone     String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([used, expiresAt])
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String
  userMessage String
  sentiment   String?
  context     Json?
  resolved    Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([resolved])
}
