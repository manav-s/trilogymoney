generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  clerkId        String        @unique
  email          String        @unique
  name           String
  phone          String        @unique
  timezone       String        @default("America/New_York")
  isVerified     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messageTime    Int           @default(9)
  messageEnabled Boolean       @default(true)
  promoCodeId    String?
  dailyNumbers   DailyNumber[]
  plaidAccount   PlaidAccount?
  subscription   Subscription?
  promoCode      PromoCode?    @relation(fields: [promoCodeId], references: [id])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  stripeId           String             @unique
  status             SubscriptionStatus
  priceId            String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEnd           DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id])
}

model PlaidAccount {
  id          String    @id @default(cuid())
  userId      String    @unique
  accessToken String
  itemId      String
  accountId   String
  bankName    String
  accountName String
  accountType String
  isActive    Boolean   @default(true)
  lastSync    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
}

model DailyNumber {
  id             String    @id @default(cuid())
  userId         String
  date           DateTime  @db.Date
  balance        Decimal   @db.Decimal(12, 2)
  yesterdaySpend Decimal   @db.Decimal(12, 2)
  weekSpend      Decimal   @db.Decimal(12, 2)
  messageSent    Boolean   @default(false)
  messageSentAt  DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  type        PromoType
  isActive    Boolean   @default(true)
  maxUses     Int?
  currentUses Int       @default(0)
  createdAt   DateTime  @default(now())
  users       User[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum PromoType {
  TRIAL_EXTENSION
  FREE_FOREVER
}
