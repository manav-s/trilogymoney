generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  // clerkId removed with Clerk
  email             String?        @unique
  phone             String?        @unique // E.164 format
  phoneVerified     Boolean        @default(false)
  timezone          String         @default("America/Los_Angeles")
  preferredTime     String         @default("09:00") // HH:mm format
  name              String?
  
  // Onboarding artifacts
  quizAnswers       Json?
  analysisSummary   Json?
  
  // Onboarding state
  onboardingStatus  String         @default("pre_auth") // pre_auth -> profile_collected -> quiz_complete -> analysis_complete -> plaid_connected -> subscribed -> complete
  consent           Boolean        @default(false)
  
  // Service status
  isActive          Boolean        @default(true)
  messagingStatus   String         @default("inactive") // inactive, active, stopped

  // Plaid
  items             PlaidItem[]

  // Billing
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  billingStatus        String? // trialing | active | incomplete | canceled
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  messages          Message[]
  
  @@index([phone])
}

model PlaidItem {
  id              String       @id @default(cuid())
  userId          String
  itemId          String       @unique
  accessToken     String       @db.Text // Encrypted with ENCRYPTION_KEY
  institutionName String?
  lastSync        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts        PlaidAccount[]
  @@index([userId])
}

model PlaidAccount {
  id               String     @id @default(cuid())
  itemId           String
  accountId        String     @unique
  name             String
  officialName     String?
  mask             String?
  type             String
  subtype          String?
  currency         String?
  currentBalance   Float?
  availableBalance Float?
  lastSync         DateTime?
  isActive         Boolean    @default(true)
  item             PlaidItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([itemId])
}

model Message {
  id        String      @id @default(cuid())
  userId    String
  direction String      // 'outbound' or 'inbound'
  content   String      @db.Text // Encrypted with ENCRYPTION_KEY
  
  // Metadata (not encrypted)
  status    String      // 'sent', 'delivered', 'failed', 'received'
  provider  String?     @default("blooio")
  providerId String?    // External message ID from SMS provider
  error     String?     @db.Text
  
  sentAt    DateTime    @default(now())
  expiresAt DateTime    // Auto-calculated: sentAt + 60 days
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([expiresAt]) // For cleanup jobs
}

model MagicLink {
  id        String   @id // Short nanoid (8-10 chars)
  phone     String   // E.164 format
  used      Boolean  @default(false)
  expiresAt DateTime // 10 minutes from creation
  createdAt DateTime @default(now())
  
  @@index([expiresAt]) // For cleanup jobs
  @@index([used, expiresAt])
}
